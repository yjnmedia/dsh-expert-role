{
  "name": "dsh-expert-role",
  "version": "2.2.1",
  "description": "专家库：按主题组织的领域资料 + 资料级检索 + 尽调工作流 + 调用可视化",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "taxonomy.json",
    "bundled",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/host-smoke.mjs && node scripts/client-smoke.mjs && node scripts/render-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "expert",
    "research"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjnmedia/dsh-expert-role.git"
  },
  "homepage": "https://github.com/yjnmedia/dsh-expert-role#readme",
  "bugs": {
    "url": "https://github.com/yjnmedia/dsh-expert-role/issues"
  },
  "author": "yjnmedia"
}
